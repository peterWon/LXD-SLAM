<launch>
    <arg name="bag_filename" default="/media/wz/2C96A0A60155E8F8/Dataset/NTU-VIRAL/nya_03/nya_03.bag"/>
    <arg name="log_dir" default="/home/wz/Data/NTU-VIRAL/LOG/lvimesher/nya_03/"/>
    
    <!-- more options are set in config/viral.yaml -->
    <rosparam file="$(find lvimesher)/config/viral/viral.yaml" command="load" />

    <group ns="lvimesher">
        <!-- basic file parameters -->
        <param name="bag_filename" value="$(arg bag_filename)" />
        <param name="log_dir" value="$(arg log_dir)" />
        <param name="log_odom_mesh_dir" value="$(arg log_dir)/odom_mesh/" />
        <param name="log_slam_mesh_dir" value="$(arg log_dir)/slam_mesh/" />
        <param name="log_slam_mesh_dir" value="$(arg log_dir)/slam_mesh/" />
        <param name="log_pcd_dir" value="$(arg log_dir)/pcd/" />

        <!-- camera models -->
        <param name="left_camera_model_path" value="$(find lvimesher)/config/cameras/viral_left.yaml" />
        <param name="right_camera_model_path" value="$(find lvimesher)/config/cameras/viral_right.yaml" />
        
        <param name="voc_file_path" value="$(find lvimesher)/config/brief_k10L6.bin" />
        <param name="brief_pattern_file_path" value="$(find lvimesher)/config/brief_pattern.yml" />
    </group>

    <node name="lvimesher" pkg="lvimesher" type="slam_node" output="screen"/>
    
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find lvimesher)/config/rviz/new.rviz" required="false" />
    
    <node required="false" pkg="rosbag" type="play" name="rosbag_player"
          args="--clock $(arg bag_filename) -r 1"/>
</launch>