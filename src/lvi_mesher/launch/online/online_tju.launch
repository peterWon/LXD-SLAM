<launch>
    <arg name="bag_filename" default="/media/wz/2C96A0A60155E8F8/Dataset/TJU/2026-06-17-19-12-49.bag"/>
    <arg name="log_dir" default="/media/wz/2C96A0A60155E8F8/Dataset/TJU/LOG/lvimesher/SYSU_02/"/>
    
    <!-- more options are set in config/livox.yaml -->
    <rosparam file="$(find lvimesher)/config/tju.yaml" command="load" />

    <group ns="lvimesher">
        <!-- basic file parameters -->
        <param name="bag_filename" value="$(arg bag_filename)" />
        <param name="log_dir" value="$(arg log_dir)" />
        <param name="log_odom_mesh_dir" value="$(arg log_dir)/odom_mesh/" />
        <param name="log_slam_mesh_dir" value="$(arg log_dir)/slam_mesh/" />
        <param name="log_slam_mesh_dir" value="$(arg log_dir)/slam_mesh/" />
        <param name="log_pcd_dir" value="$(arg log_dir)/pcd/" />
        <param name="enable_mesh_texture" value="false" />
        
        <param name="rescale_imu_data" value="true" />

        <!-- camera models -->
        <param name="left_camera_model_path" value="$(find lvimesher)/config/cameras/tju.yaml" />

        <!-- topics -->
        <param name="voc_file_path" value="$(find lvimesher)/config/brief_k10L6.bin" />
        <param name="brief_pattern_file_path" value="$(find lvimesher)/config/brief_pattern.yml" />
    </group>


    <node name="lvimesher" pkg="lvimesher" type="slam_node" output="screen"/>
    
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find lvimesher)/config/rviz/new.rviz" required="false" />
    
    <node required="false" pkg="rosbag" type="play" name="rosbag_player"
          args="--clock $(arg bag_filename) -s 0 -r 1"/>
    
    <node pkg="image_transport" type="republish" name="republish" args="compressed in:=/left_camera/image raw out:=/left_camera/image" output="screen" respawn="true"/>
</launch>